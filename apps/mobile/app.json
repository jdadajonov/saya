{
  "expo": {
    "name": "Saya",
    "slug": "saya",
    "scheme": "saya",
    "version": "1.0.0",
    "orientation": "portrait",
    "platforms": [
      "ios"
    ],
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFE66D"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.saya.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Используется для голосовых ответов",
        "NSSpeechRecognitionUsageDescription": "Используется для голосового ввода",
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.414719156571-eifebfi60g07dq2sv5ecmo8akcgoosq2"
            ]
          },
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.414719156571-eifebfi60g07dq2sv5ecmo8akcgoosq2"
            ]
          }
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4ECDC4"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFE66D",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      "expo-font",
      "expo-sqlite"
    ],
    "extra": {
      "eas": {
        "projectId": "3f65c8ef-1a78-4187-b104-3077a47fa9e8"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    },
    "owner": "jdadajonov"
  }
}
